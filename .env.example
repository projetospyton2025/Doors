# Ambiente: development | production
APP_ENV=development
DEBUG=true

# Identificação
APP_NAME=Doors
APP_SECRET_KEY=altere-esta-chave-em-producao

# SQLite local (arquivo persistente em ./data)
DATABASE_URL=sqlite:///./data/doors.db

# Para PostgreSQL no futuro:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/doors

# Hosts permitidos (separados por vírgula). Use * apenas em desenvolvimento.
ALLOWED_HOSTS=*

# Caminho opcional do Excel original para importação inicial
DOORS_XLSX_PATH=./Doors.xlsx

# Porta reservada deste sistema
APP_HOST=127.0.0.1
APP_PORT=5333
